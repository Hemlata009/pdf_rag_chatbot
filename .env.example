# Required for answer generation through OpenRouter (use a fresh key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=PDF RAG Chatbot — LangChain

# LangChain document ingestion and retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_K=6
LLM_CONTEXT_K=3
# dense = FAISS similarity; hybrid = FAISS + BM25 with reciprocal-rank fusion
RETRIEVAL_MODE=dense

# Approximate context budget (prompt + output + margin)
CONTEXT_LIMIT=4096
MAX_OUTPUT_TOKENS=800
SAFETY_MARGIN=150
LLM_TEMPERATURE=0.1
REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# SQLite conversation memory; complete messages remain on disk, only bounded context is sent to the LLM
MEMORY_DB_PATH=data/chat_history.db
HISTORY_MAX_TURNS=5
HISTORY_TOKEN_BUDGET=350
SUMMARY_TRIGGER_TURNS=5
SUMMARY_TOKEN_LIMIT=250

# Local persistence
RAG_DATA_DIR=data
DOCUMENTS_DIR=data/documents
INDEXES_DIR=data/indexes
